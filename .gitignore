# Sharing boundary: everything stays local unless explicitly allowed below.
# Review new paths before expanding this list. Ignored files are NOT backed up.
/*
!/.gitignore
!/README.md

# Consumer-facing design notes only.
!/principles/
/principles/**
!/principles/**/
!/principles/**/*.md
!/widgets/
/widgets/**
!/widgets/**/
!/widgets/**/*.md
!/references/
/references/**
!/references/**/
!/references/**/*.md
!/visuals/
/visuals/**
!/visuals/**/
!/visuals/**/*.md
/visuals/media-discovery-routes.md

# Standalone UI recipes: do not admit arbitrary third-party source trees.
!/implementation/
/implementation/**
!/implementation/*.md
!/implementation/code/
/implementation/code/*
!/implementation/code/BUILD.md
!/implementation/code/demo_menu.h
!/implementation/code/fatality_visuals.h
!/implementation/code/gamesense_menu.h
!/implementation/code/glass_sidebar_menu.h
!/implementation/code/headless_test.cpp
!/implementation/code/hud_elements.h
!/implementation/code/menu_anim.h
!/implementation/code/menu_draw.h
!/implementation/code/menu_style.h
!/implementation/code/menu_widgets.h
!/implementation/code/popup_menus.h

# Media and provenance needed to use the references (not discovery queues).
!/assets/
/assets/**
!/assets/**/
!/assets/**/*.png
!/assets/**/*.mp4
!/assets/**/*.fig
!/assets/**/*.ttf
!/assets/**/LICENSE.txt
!/assets/*-manifest.json
!/assets/*-sources.json

# Production helpers only, not vault-maintenance scripts.
!/tools/
/tools/**
!/tools/sample_colors.py
!/tools/preview/
/tools/preview/*
!/tools/preview/render_preview.cpp

# Never publish local settings, maintenance instructions, credentials or builds.
.obsidian/
CLAUDE.md
AGENTS.md
READMEFIRST.md
templates/
.env
.env.*
*.pem
*.key
*.p12
*.pfx
__pycache__/
*.pyc
imgui.ini
*.o
*.obj
*.so
*.dll
*.exe
*.pdb
*.a
*.lib
*.zip
*.7z
*.rar
build/
dist/
node_modules/
